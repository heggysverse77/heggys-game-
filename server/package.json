{
  "name": "heggy-game-server",
  "version": "1.0.0",
  "description": "Backend server for اعرف صاحبك وعلّم عليه multiplayer game",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test:db": "tsx src/scripts/test-db.ts",
    "bots": "tsx src/scripts/simulate-bots.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "pg": "^8.13.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
