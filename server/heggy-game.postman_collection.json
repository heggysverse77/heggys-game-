{
  "info": {
    "_postman_id": "heggy-multiplayer-game-api",
    "name": "Heggy Game Server API (اعرف صاحبك وعلّم عليه)",
    "description": "Full collection of REST APIs for authentication, room creation, question bank contribution, and game status lookup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "gameId",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomCode",
      "value": "X8K2M",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Guest Login (Quick Play)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"HeggyHost\",\n  \"avatarId\": \"avatar_1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/guest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "guest"]
            }
          }
        },
        {
          "name": "Register Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"HeggyVIP\",\n  \"email\": \"heggy@game.com\",\n  \"password\": \"password123\",\n  \"avatarId\": \"avatar_3\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"heggy@game.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Game Rooms",
      "item": [
        {
          "name": "Create Game Room (Host)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.game) {",
                  "    pm.collectionVariables.set('gameId', jsonData.data.game.id);",
                  "    pm.collectionVariables.set('roomCode', jsonData.data.game.room_code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalRounds\": 5,\n  \"maxPlayers\": 8,\n  \"answeringTimerSec\": 30,\n  \"matchingTimerSec\": 45,\n  \"dareEnabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/games",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "games"]
            }
          }
        },
        {
          "name": "Pre-check Room Code (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/games/code/{{roomCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "games", "code", "{{roomCode}}"]
            }
          }
        },
        {
          "name": "Get Game Details by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/games/{{gameId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "games", "{{gameId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Question Bank",
      "item": [
        {
          "name": "Add Custom Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"textAr\": \"إيه أغرب حاجة اشتريتها وندمت عليها فوراً؟\",\n  \"textEn\": \"What is the weirdest thing you bought and immediately regretted?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions"]
            }
          }
        },
        {
          "name": "List Active Questions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions"]
            }
          }
        }
      ]
    }
  ]
}
